# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache / build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Generated transcription outputs (do not commit personal recordings/transcripts)
*.txt
*.srt
*.mp3
*.mp4
*.mkv
*.wav
*.m4a

# Keep the files that are part of the tool even though *.txt is ignored above
!requirements.txt
!domain_vocab.txt
!corrections.txt
!vocab_work.txt

# PRIVATE vocabulary: colleague names and internal project names live in
# *.local.txt so they are never committed or shared. Keep this rule last.
*.local.txt

# IDE / editor
.vscode/
.idea/

# OS files
Thumbs.db
.DS_Store
